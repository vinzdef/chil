{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `DOM` for WebCrypto and IndexedDB. Both are browser-first here; the
    // memory key store exists so this package still runs under Node for tests.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}

{
  "name": "@chiljs/react",
  "version": "0.2.1",
  "description": "Headless React hooks for the CHIL token exchange. No markup, no styles, no renderer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@chiljs/client": "0.2.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinzdef/chil.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/vinzdef/chil#readme",
  "bugs": {
    "url": "https://github.com/vinzdef/chil/issues"
  },
  "author": "Vincent De Feo",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "handoff",
    "upload",
    "react",
    "hooks",
    "headless"
  ]
}
